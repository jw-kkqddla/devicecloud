@model DeviceCloud.Web.Pages.Devices.DetailModel
<!-- 属性日志 -->
<div class="tab-pane fade" id="property-log" role="tabpanel">
    <div class="d-flex justify-content-between align-items-center mt-2" style="padding: 8px 0;">
        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm" id="chartPropertySelect" style="width: 210px;">
                @foreach (var g in Model.ChartPropertyGroups)
                {
                    <optgroup label="@g.Label">
                        @foreach (var item in g.Items)
                            {
                                <option value="@item.Name">@item.Name</option>
                            }
                            </optgroup>
                }
            </select>
            <select class="form-select form-select-sm" id="chartTimeRange" style="width: 100px;">
                <option value="1h">近1小时</option>
                <option value="6h">近6小时</option>
                <option value="24h" selected>今日</option>
                <option value="7d">近7天</option>
            </select>
            <button class="btn btn-sm btn-outline-primary" onclick="refreshChartData()">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <div class="chart-wrapper" style="position: relative; height: 450px; width: 1200px; margin: 0 auto; background: transparent;">
        <canvas id="historyChart" style="display: block; width: 100%; height: 100%;"></canvas>
        <div id="chartPlaceholder" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: transparent; color: #9ca3af; pointer-events: none;">
            <div class="text-center">
                <i class="bi bi-graph-up" style="font-size: 48px;"></i>
                <p class="mt-2 mb-0">选择属性查看历史数据</p>
            </div>
        </div>
    </div>
</div>
