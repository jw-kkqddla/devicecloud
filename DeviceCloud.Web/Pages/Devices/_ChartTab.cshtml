@model DeviceCloud.Web.Pages.Devices.DetailModel
<!-- 月发电量柱状图 -->
<div class="tab-pane fade" id="business-log" role="tabpanel">
    <div class="card mt-2" style="border: none; border-radius: 0;">
        <div class="card-header bg-white d-flex justify-content-between align-items-center rounded-top" style="border-bottom: none; padding: 8px 12px;">
            <div class="mb-0 d-flex align-items-center" style="font-size: 15px; color: #1f2937;">
                <span class="me-2 d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #3b82f6;"></span>月发电量
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="month" class="form-control form-control-sm" id="energyMonthPicker" style="width: 150px;" onchange="refreshMonthlyEnergy()"/>
            </div>
        </div>
        <div class="card-body" style="padding: 12px;">
            <div style="position: relative; height: 250px;">
                <canvas id="monthlyEnergyChart" style="display:block;width:100%;height:100%;"></canvas>
            </div>
        </div>
    </div>
</div>
