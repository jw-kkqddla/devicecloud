@model DeviceCloud.Web.Pages.Devices.DetailModel
<!-- 数据总览 -->
<div class="tab-pane fade show active" id="overview" role="tabpanel">
    <!-- 数据更新时间 -->
    <div class="d-flex justify-content-end align-items-center mb-3 text-muted" style="font-size: 13px;">
        <span>数据更新时间：@(string.IsNullOrEmpty(Model.Device.UpdateTimeDisplay) ? DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") : Model.Device.UpdateTimeDisplay)</span>
        <i class="bi bi-arrow-clockwise text-primary ms-2" style="cursor: pointer; font-size: 14px;" onclick="location.reload()"></i>
    </div>

    <!-- 属性字段分组展示 - 网格(4列) -->
    @if (Model.PropertyFieldGroups != null && Model.PropertyFieldGroups.Any())
    {
        foreach (var group in Model.PropertyFieldGroups)
        {
            <!-- 分组标题 -->
            <div class="mt-3 mb-2 d-flex align-items-center" style="font-size: 17px; color: #1f2937;">
                @group.GroupName
            </div>

            @for (int i = 0; i < group.Fields.Count; i += 4)
            {
                <div class="row py-3 border-bottom align-items-center" style="font-size: 15px;">
                    @for (int j = i; j < i + 4 && j < group.Fields.Count; j++)
                    {
                        <div class="col-md-3 mb-3">
                            <div class="text-secondary mb-1">@group.Fields[j].Label</div>
                            <div class="text-black fw-medium" style="word-break: break-word;">@group.Fields[j].Value</div>
                        </div>
                    }
                </div>
            }
        }
    }
    else
    {
        <!-- 无属性数据时的占位 -->
        <div class="text-center py-4 text-muted">
            <i class="bi bi-inbox" style="font-size: 32px;"></i>
            <p class="mt-2 mb-0">暂无物模型属性数据</p>
            @if (!string.IsNullOrEmpty(Model.TslError))
            {
                <p class="mt-2 mb-0 text-danger">物模型解析失败：@Model.TslError</p>
            }
        </div>
    }
</div>
