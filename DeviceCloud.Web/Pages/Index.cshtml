@page
@model IndexModel
@{
    ViewData["Title"] = "系统概览";
}

<div class="row">
    <!-- 统计卡片 -->
    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="text-muted small">设备总数</div>
                        <div class="fs-4 fw-bold">1</div>
                    </div>
                    <div class="text-primary fs-1">
                        <i class="bi bi-hdd-rack"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="text-muted small">在线设备</div>
                        <div class="fs-4 fw-bold">1</div>
                    </div>
                    <div class="text-success fs-1">
                        <i class="bi bi-activity"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="text-muted small">产品数量</div>
                        <div class="fs-4 fw-bold">1</div>
                    </div>
                    <div class="text-warning fs-1">
                        <i class="bi bi-box"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="text-muted small">告警数量</div>
                        <div class="fs-4 fw-bold">1</div>
                    </div>
                    <div class="text-danger fs-1">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
