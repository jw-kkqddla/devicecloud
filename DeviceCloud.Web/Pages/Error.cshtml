@page
@model ErrorModel
@{
    ViewData["Title"] = "错误";
}

<h1 class="text-danger">错误</h1>
<h2 class="text-danger">处理请求时发生错误。</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>开发模式</h3>
<p>
    切换到 <strong>开发</strong> 环境将显示更详细的错误信息。
</p>
