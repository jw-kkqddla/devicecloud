<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 设备管理平台</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-wrapper">
        <!-- 侧边栏 -->
        <aside class="sidebar-container" id="sidebar">
            <!-- Logo -->
            <div class="sidebar-logo">
                <a href="/">
                    <span class="logo-title">设备管理平台</span>
                </a>
            </div>

            <!-- 菜单 -->
            <ul class="sidebar-menu" id="sidebarMenu">
                @{
                    var currentPath = Context.Request.Path.Value ?? "/";
                }
                <li class="menu-item @(currentPath == "/" || currentPath == "/Index" ? "active" : "")">
                    <a href="/" title="系统概览">
                        <i class="bi bi-speedometer2 menu-icon"></i>
                        <span class="menu-title">系统概览</span>
                    </a>
                </li>

                <!-- 产品管理 -->
                <li class="menu-item @(currentPath.StartsWith("/Products") || currentPath.StartsWith("/ThingModels") ? "active open" : "")">
                    <a href="javascript:;">
                        <i class="bi bi-box menu-icon"></i>
                        <span class="menu-title">产品管理</span>
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </a>
                    <ul class="submenu">
                        <li class="menu-item @(currentPath == "/Products/Index" || currentPath == "/Products" ? "active" : "")">
                            <a href="/Products/Index"><i class="bi bi-list-ul menu-icon"></i><span class="menu-title">产品列表</span></a>
                        </li>
                        <li class="menu-item @(currentPath.StartsWith("/ThingModels") ? "active" : "")">
                            <a href="/ThingModels/Index"><i class="bi bi-diagram-3 menu-icon"></i><span class="menu-title">物模型</span></a>
                        </li>
                    </ul>
                </li>

                <!-- 设备管理 -->
                <li class="menu-item @(currentPath.StartsWith("/Devices") ? "active open" : "")">
                    <a href="javascript:;">
                        <i class="bi bi-hdd-rack menu-icon"></i>
                        <span class="menu-title">设备管理</span>
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </a>
                    <ul class="submenu">
                        <li class="menu-item @(currentPath.StartsWith("/Devices") ? "active" : "")">
                            <a href="/Devices"><i class="bi bi-device-hdd menu-icon"></i><span class="menu-title">设备列表</span></a>
                        </li>
                        <li class="menu-item">
                            <a href="#"><i class="bi bi-geo-alt menu-icon"></i><span class="menu-title">设备运维</span></a>
                        </li>
                    </ul>
                </li>

                <!-- 消息订阅管理 -->
                <li class="menu-item @(currentPath.StartsWith("/Subscriptions") ? "active open" : "")">
                    <a href="javascript:;">
                        <i class="bi bi-bell menu-icon"></i>
                        <span class="menu-title">消息订阅管理</span>
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </a>
                    <ul class="submenu">
                        <li class="menu-item @(currentPath == "/Subscriptions/Queues" ? "active" : "")">
                            <a href="/Subscriptions/Queues"><i class="bi bi-list-ul menu-icon"></i><span class="menu-title">队列列表</span></a>
                        </li>
                    </ul>
                </li>

                <!-- 数据监控 -->
                <li class="menu-item @(currentPath.StartsWith("/Monitor") ? "active open" : "")">
                    <a href="javascript:;">
                        <i class="bi bi-graph-up menu-icon"></i>
                        <span class="menu-title">数据监控</span>
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </a>
                    <ul class="submenu">
                        <li class="menu-item">
                            <a href="#"><i class="bi bi-activity menu-icon"></i><span class="menu-title">实时数据</span></a>
                        </li>
                        <li class="menu-item">
                            <a href="#"><i class="bi bi-bar-chart menu-icon"></i><span class="menu-title">历史数据</span></a>
                        </li>
                    </ul>
                </li>

                <!-- 系统设置 -->
                <li class="menu-item @(currentPath.StartsWith("/System") ? "active open" : "")">
                    <a href="javascript:;">
                        <i class="bi bi-gear menu-icon"></i>
                        <span class="menu-title">系统设置</span>
                        <i class="bi bi-chevron-right menu-arrow"></i>
                    </a>
                    <ul class="submenu">
                        <li class="menu-item">
                            <a href="#"><i class="bi bi-person menu-icon"></i><span class="menu-title">用户管理</span></a>
                        </li>
                        <li class="menu-item">
                            <a href="#"><i class="bi bi-key menu-icon"></i><span class="menu-title">认证管理</span></a>
                        </li>
                        <li class="menu-item">
                            <a href="#"><i class="bi bi-sliders menu-icon"></i><span class="menu-title">参数设置</span></a>
                        </li>
                    </ul>
                </li>
            </ul>
        </aside>

        <!-- 主内容区 -->
        <div class="main-container" id="mainContainer">
            <!-- 顶部导航 -->
            <header class="navbar" id="navbar">
                <div class="navbar-left">
                    <span class="hamburger" id="hamburger" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </span>
                    <nav class="breadcrumb">
                        <a href="/">首页</a>
                        @if (ViewData["Breadcrumb"] != null)
                        {
                            @foreach (var item in (List<(string Title, string? Url)>)ViewData["Breadcrumb"]!)
                            {
                                <span class="separator">/</span>
                                @if (string.IsNullOrEmpty(item.Url))
                                {
                                    <span>@item.Title</span>
                                }
                                else
                                {
                                    <a href="@item.Url">@item.Title</a>
                                }
                            }
                        }
                    </nav>
                </div>

                <div class="navbar-right">
                    <!-- 全屏 -->
                    <span class="hamburger fullscreen-btn" onclick="toggleFullscreen()" title="全屏">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </span>

                    <!-- 用户下拉菜单 -->
                    <div class="user-dropdown">
                        <i class="bi bi-person-circle user-avatar-icon"></i>
                        <span class="user-name">管理员</span>
                        <i class="bi bi-caret-down-fill"></i>

                        <div class="user-dropdown-menu">
                            <a href="#"><i class="bi bi-person"></i> 个人中心</a>
                            <a href="#"><i class="bi bi-gear"></i> 系统设置</a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- 主内容 -->
            <main class="app-main">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
