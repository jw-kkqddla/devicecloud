@page
@model IndexModel
@{
    ViewData["Title"] = "产品列表";
    ViewData["Breadcrumb"] = new List<(string Title, string? Url)>
    {
        ("产品管理", null),
        ("产品列表", null)
    };
}

<div class="card">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- 搜索栏 -->
<form class="row g-3 mb-3" method="get">
    @* <div class="col-md-3">
        <input type="text" name="productKey" value="@Model.ProductKey"
               class="form-control" placeholder="产品Key *" required />
    </div>*@
    <div class="col-md-2">
        <input type="text" name="productKey" value="@Model.ProductKey"
               class="form-control" placeholder="产品Key" />
    </div>
    <div class="col-md-2">
        <input type="text" name="productName" value="@Model.ProductName"
               class="form-control" placeholder="产品名称" />
    </div>

    <!-- 搜索/重置 -->
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> 搜索
        </button>
        <button type="button" class="btn btn-bg btn-circle" onclick="location.href='/Products/Index'">
            <i class="bi bi-arrow-clockwise"></i> 
        </button>
    </div>

    <!-- 工具栏：推到最右边 -->
    <div class="col-md-5 d-flex justify-content-end align-items-center gap-2">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="bi bi-plus-lg"></i> 新增
        </button>
        <button type="button" class="btn btn-primary" onclick="handleExport()">
            <i class="bi bi-download"></i> 导出
        </button>
    </div>
</form>

        <!-- 表格 -->
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th><input type="checkbox" onchange="toggleSelectAll(this)"></th>
                        <th>产品名称</th>
                        <th>产品Key</th>
                        <th>接入类型</th>
                        <th>数据格式</th>
                        <th>创建时间</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products.Any())
                    {
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td><input type="checkbox"></td>
                                <td>
                                    @product.ProductName
                                </td>
                                <td>@product.ProductKey</td>
                                <td>@product.AccessTypeDisplay</td>
                                <td>@product.DataFmtDisplay</td>
                                <td>@product.CreateTimeLocal.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <button class="btn btn-link btn-sm text-primary" onclick="handleDetail('@product.ProductKey')">
                                        详情
                                    </button>
                                    <button class="btn btn-link btn-sm text-primary" onclick="handleEdit('@product.ProductKey')">
                                        修改
                                    </button>
                                    <button class="btn btn-link btn-sm text-primary" onclick="handleViewTsl('@product.ProductKey')">
                                        物模型
                                    </button>
                                    <button class="btn btn-link btn-sm text-primary" onclick="handleDelete('@product.ProductKey')">
                                        删除
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3"></i>
                                <p class="mb-0">暂无数据</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 分页 -->
        <div class="d-flex justify-content-between align-items-center">
            <div class="text-muted">共 @Model.Products.Count 条记录</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNum <= 1 ? "disabled" : "")">
                        <a class="page-link" href="?productName=@Model.ProductName&productKey=@Model.ProductKey&pageNum=@(Model.PageNum - 1)&pageSize=@Model.PageSize">上一页</a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">@Model.PageNum</a></li>
                    <li class="page-item @(Model.Products.Count < Model.PageSize ? "disabled" : "")">
                        <a class="page-link" href="?productName=@Model.ProductName&productKey=@Model.ProductKey&pageNum=@(Model.PageNum + 1)&pageSize=@Model.PageSize">下一页</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- 弹窗 -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">新增产品</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="productForm">
                    <div class="mb-3">
                        <label class="form-label">产品名称 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="请输入产品名称" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">产品Key</label>
                        <input type="text" class="form-control" placeholder="请输入产品Key">
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">显示排序</label>
                            <input type="number" class="form-control" value="0" min="0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">状态</label>
                            <select class="form-select">
                                <option value="1">已发布</option>
                                <option value="0">未发布</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">备注</label>
                        <textarea class="form-control" rows="3" placeholder="请输入备注"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="submitForm()">确定</button>
            </div>
        </div>
    </div>
</div>

<!-- 右侧详情面板 -->
<div class="detail-panel" id="detailPanel">
    <div class="detail-panel-header">
        <h5 class="detail-panel-title">
            <i class="bi bi-box"></i> <span id="detailProductName">产品详情</span>
        </h5>
        <button type="button" class="btn-close" onclick="closeDetailPanel()"></button>
    </div>
    <div class="detail-panel-body" id="detailPanelBody">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">加载中...</span>
            </div>
        </div>
    </div>
</div>
<div class="detail-panel-overlay" id="detailPanelOverlay" onclick="closeDetailPanel()"></div>

@section Scripts {
    <style>
        /* 右侧详情面板样式 */
        .detail-panel {
            position: fixed;
            top: 0;
            right: -450px;
            width: 450px;
            height: 100vh;
            background: #fff;
            box-shadow: -5px 0 20px rgba(0, 0, 0, 0.1);
            z-index: 1050;
            transition: right 0.3s ease-in-out;
            display: flex;
            flex-direction: column;
        }
        .detail-panel.show {
            right: 0;
        }
        .detail-panel-header {
            padding: 20px;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8f9fa;
        }
        .detail-panel-title {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
            color: #333;
        }
        .detail-panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }
        .detail-panel-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.3);
            z-index: 1040;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease-in-out;
        }
        .detail-panel-overlay.show {
            opacity: 1;
            visibility: visible;
        }
        .detail-item {
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px dashed #e9ecef;
        }
        .detail-item:last-child {
            border-bottom: none;
        }
        .detail-label {
            font-size: 0.85rem;
            color: #6c757d;
            margin-bottom: 4px;
        }
        .detail-value {
            font-size: 1rem;
            color: #333;
            font-weight: 500;
            word-break: break-all;
        }
        .detail-logo {
            max-width: 100%;
            max-height: 150px;
            border-radius: 8px;
            border: 1px solid #e9ecef;
        }
    </style>
    <script>
        function handleAdd() {
            document.getElementById('modalTitle').textContent = '新增产品';
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }

        function handleEdit(productKey) {
            document.getElementById('modalTitle').textContent = '修改产品';
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }

        function handleViewTsl(productKey) {
            window.location.href = '/ThingModels/Index?productKey=' + encodeURIComponent(productKey);
        }

        function handleDelete(productKey) {
            if (confirm('是否确认删除该产品？')) {
                // 删除逻辑
            }
        }

        function handleExport() {
            alert('导出功能开发中...');
        }

        function submitForm() {
            // 提交逻辑
            bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
        }

        function toggleSelectAll(checkbox) {
            var checkboxes = document.querySelectorAll('tbody input[type="checkbox"]');
            checkboxes.forEach(function(cb) {
                cb.checked = checkbox.checked;
            });
        }

        // 详情面板相关函数
        function handleDetail(productKey) {
            // 显示面板
            document.getElementById('detailPanel').classList.add('show');
            document.getElementById('detailPanelOverlay').classList.add('show');

            // 显示加载状态
            document.getElementById('detailPanelBody').innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">加载中...</span>
                    </div>
                </div>
            `;
            document.getElementById('detailProductName').textContent = '产品详情';

            // 调用 API 获取详情
            fetch(`/Products/Index?handler=Detail&productKey=${encodeURIComponent(productKey)}`)
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        const data = result.data;
                        document.getElementById('detailProductName').textContent = data.productName;

                        let logoHtml = '';
                        if (data.logoPath) {
                            logoHtml = `
                                <div class="detail-item">
                                    <div class="detail-label">产品Logo</div>
                                    <img src="${data.logoPath}" alt="产品Logo" class="detail-logo" onerror="this.style.display='none'">
                                </div>
                            `;
                        }

                        document.getElementById('detailPanelBody').innerHTML = `
                            ${logoHtml}
                            <div class="detail-item">
                                <div class="detail-label">产品Key</div>
                                <div class="detail-value">${data.productKey}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">产品名称</div>
                                <div class="detail-value">${data.productName}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">接入类型</div>
                                <div class="detail-value">${data.accessTypeDisplay}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">联网方式</div>
                                <div class="detail-value">${data.netWay}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">数据格式</div>
                                <div class="detail-value">${data.dataFmtDisplay}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">连接平台</div>
                                <div class="detail-value">${data.connectPlatform}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">创建时间</div>
                                <div class="detail-value">${data.createTime}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">更新时间</div>
                                <div class="detail-value">${data.updateTime}</div>
                            </div>
                        `;
                    } else {
                        document.getElementById('detailPanelBody').innerHTML = `
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle"></i> ${result.message || '获取产品详情失败'}
                            </div>
                        `;
                    }
                })
                .catch(error => {
                    document.getElementById('detailPanelBody').innerHTML = `
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> 请求失败: ${error.message}
                        </div>
                    `;
                });
        }

        function closeDetailPanel() {
            document.getElementById('detailPanel').classList.remove('show');
            document.getElementById('detailPanelOverlay').classList.remove('show');
        }

        // ESC 键关闭面板
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeDetailPanel();
            }
        });
    </script>
}
