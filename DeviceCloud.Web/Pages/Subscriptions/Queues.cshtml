@page
@model QueuesModel
@{
    ViewData["Title"] = "队列列表";
    ViewData["Breadcrumb"] = new List<(string Title, string? Url)>
    {
        ("消息订阅管理", null),
        ("队列列表", null)
    };
}

<div class="card">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- 工具栏 -->
        <div class="mb-3">
            <button type="button" class="btn btn-bg btn-circle" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise"></i> 
            </button>
        </div>

        <!-- 表格 -->
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>队列名称</th>
                        <th>队列描述</th>
                        <th>状态</th>
                        <th>用户ID</th>
                        <th>创建时间</th>
                        <th>更新时间</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Queues.Any())
                    {
                        @foreach (var queue in Model.Queues)
                        {
                            <tr>
                                <td>@queue.Id</td>
                                <td>@queue.QueueName</td>
                                <td>@queue.QueueDesc</td>
                                <td>
                                    <span class="badge bg-@queue.StatusBadge">@queue.StatusDisplay</span>
                                </td>
                                <td>@queue.UserId</td>
                                <td>@queue.CreateTimeLocal.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(queue.UpdateTimeLocal?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3"></i>
                                <p class="mb-0">暂无数据</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
