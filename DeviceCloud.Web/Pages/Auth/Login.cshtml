@page
@model LoginModel
@{
    ViewData["Title"] = "认证管理";
}

<div class="card">
    <div class="card-header">
        <i class="bi bi-key"></i> 认证管理
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                @if (Model.TokenInfo != null)
                {
                    @if (Model.TokenInfo.Success && Model.TokenInfo.Data != null)
                    {
                        var token = Model.TokenInfo.Data;
                        <div class="alert alert-success">
                            <h5><i class="bi bi-check-circle me-2"></i>@Model.TokenInfo.Message</h5>
                            <hr>
                            <p><strong>状态:</strong> <span class="text-success">有效</span></p>
                            <p><strong>Token 类型:</strong> @token.TokenType</p>
                            <p><strong>有效期:</strong> @token.ExpiresIn 秒</p>
                            @if (token.ExpiresAt.HasValue)
                            {
                                <p><strong>过期时间:</strong> @token.ExpiresAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</p>
                            }
                            <p><strong>Access Token:</strong></p>
                            <code style="display: block; margin-top: 4px; word-break: break-all; background: #f5f5f5; padding: 10px; border-radius: 4px;">@(token.AccessToken.Length > 100 ? token.AccessToken.Substring(0, 100) + "..." : token.AccessToken)</code>
                        </div>
                    }
                    else if (!Model.TokenInfo.Success)
                    {
                        <div class="alert alert-danger d-flex align-items-start">
                            <i class="bi bi-exclamation-triangle me-2 mt-1"></i>
                            <div>
                                <strong>错误代码:</strong> @Model.TokenInfo.ErrorCode<br>
                                @Model.TokenInfo.Message
                            </div>
                        </div>
                    }
                }

                <form method="post">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-key"></i> 获取 Access Token
                    </button>
                </form>
            </div>
            <div class="col-md-6">
                <div class="card bg-light">
                    <div class="card-body">
                        <h6><i class="bi bi-info-circle me-2"></i>使用说明</h6>
                        <p class="text-muted mb-2">点击"获取 Access Token"按钮获取 API 访问令牌。</p>
                        <p class="text-muted mb-0">该 Token 用于调用设备管理平台 API 接口的身份认证。</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
